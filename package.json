{
  "name": "affiliate-operations-hq",
  "private": true,
  "version": "0.1.0",
  "description": "Control plane and automation runner for multi-channel affiliate operations.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @affiliate-ops/web",
    "dev:web": "npm run dev --workspace @affiliate-ops/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean:local": "node scripts/clean-local-artifacts.mjs",
    "repo:check": "node scripts/repo-check.mjs",
    "office:v2:clean-room:check": "node scripts/office-v2-clean-room-check.mjs",
    "office:v2:boundaries:check": "node scripts/office-v2-boundary-check.mjs",
    "office:v2:boundaries:test": "node --test scripts/office-v2-boundary-check.test.mjs",
    "office:v2:contradictions:check": "node scripts/office-v2-contradictions-check.mjs",
    "office:v2:contradictions:test": "node --test scripts/office-v2-contradictions-check.test.mjs",
    "office:v2:contracts:generate": "node scripts/office-v2-contracts-generate.mjs --write",
    "office:v2:contracts:check": "node scripts/office-v2-contracts-generate.mjs --check",
    "office:v2:contracts:test": "node --test scripts/office-v2-contracts-generate.test.mjs",
    "office:v2:knowledge:check": "node scripts/office-v2-knowledge-check.mjs",
    "office:v2:knowledge:test": "node --test scripts/office-v2-knowledge-check.test.mjs",
    "office:v2:closure-d:test": "node --test scripts/office-v2-closure-d-evidence.test.mjs",
    "office:v2:world:evidence": "node --test scripts/office-v2-world-reference-evidence.test.mjs",
    "office:v2:w1-2:evidence": "node --test scripts/office-v2-world-w1-2-evidence.test.mjs",
    "office:v2:assets:check": "node scripts/office-v2-asset-check.mjs",
    "office:v2:phase4:model": "node scripts/office-v2-phase4-model.mjs --runs 100",
    "office:v2:phase4:model:test": "node --test scripts/office-v2-phase4-model.test.mjs",
    "office:v2:phase4:golden:check": "node scripts/office-v2-phase4-golden-check.mjs",
    "office:v2:phase4:qa:check": "node scripts/office-v2-phase4-qa-check.mjs",
    "office:v2:phase3:acceptance": "node scripts/office-v2-phase3-exit.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "code:health": "node scripts/code-health.mjs",
    "duplicate:check": "node scripts/duplicate-check.mjs",
    "code:map": "node scripts/code-map.mjs",
    "planning:validate": "node .agents/skills/deep-operations-planner/scripts/validate-plan.mjs",
    "planning:validate:test": "node --test .agents/skills/deep-operations-planner/scripts/validate-plan.test.mjs",
    "pilot:simulate": "node services/automation-runner/src/simulation/cli.ts",
    "deploy:dry-run": "npm run build --workspace @affiliate-ops/web && npx --yes wrangler@4.113.0 deploy --dry-run --config wrangler.jsonc",
    "deploy:cloudflare": "npm run build --workspace @affiliate-ops/web && npx --yes wrangler@4.113.0 deploy --config wrangler.jsonc",
    "check": "npm run repo:check && npm run planning:validate:test && npm run office:v2:clean-room:check && npm run office:v2:boundaries:check && npm run office:v2:boundaries:test && npm run office:v2:contradictions:check && npm run office:v2:contradictions:test && npm run office:v2:contracts:check && npm run office:v2:contracts:test && npm run office:v2:knowledge:check && npm run office:v2:knowledge:test && npm run office:v2:world:evidence && npm run office:v2:w1-2:evidence && npm run office:v2:assets:check && npm run office:v2:phase4:model:test && npm run office:v2:phase4:golden:check && npm run office:v2:phase4:qa:check && npm run architecture:check && npm run code:health && npm run duplicate:check && npm run code:map && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-check": "4.9.0",
    "playwright": "1.62.1"
  }
}
