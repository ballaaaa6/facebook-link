{
  "name": "affiliate-operations-hq",
  "private": true,
  "version": "0.1.0",
  "description": "Control plane and automation runner for multi-channel affiliate operations.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @affiliate-ops/web",
    "dev:web": "npm run dev --workspace @affiliate-ops/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "repo:check": "node scripts/repo-check.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "code:health": "node scripts/code-health.mjs",
    "duplicate:check": "node scripts/duplicate-check.mjs",
    "code:map": "node scripts/code-map.mjs",
    "art:prompt": "node scripts/office-asset-prompt.mjs",
    "art:prompt:check": "node scripts/office-asset-prompt.mjs --check",
    "art:geometry:check": "node scripts/office-geometry-check.mjs",
    "art:geometry:audit": "python scripts/audit-office-asset-geometry.py",
    "art:geometry:audit:check": "python scripts/audit-office-asset-geometry.py --check",
    "art:geometry:bible": "python scripts/build-office-camera-scale-board.py",
    "art:geometry:bible:check": "python scripts/build-office-camera-scale-board.py --check",
    "art:workstation:bible": "python scripts/build-office-workstation-assembly-bible.py",
    "art:workstation:bible:check": "python scripts/build-office-workstation-assembly-bible.py --check",
    "art:workstation:v2": "python scripts/build-office-workstation-v2.py",
    "art:workstation:v2:check": "node scripts/office-workstation-v2-check.mjs",
    "art:workstation:step5:check": "node scripts/office-workstation-step5-check.mjs",
    "art:workstation:step5:r03": "python scripts/build-office-workstation-step5-r03-calibration.py",
    "art:workstation:step5:r03:check": "node scripts/office-workstation-step5-r03-check.mjs",
    "art:workstation:step5:r04": "python scripts/build-office-workstation-step5-r04.py",
    "art:workstation:step5:r04:check": "node scripts/office-workstation-step5-r04-check.mjs",
    "art:workstation:step5:r05": "python scripts/build-office-workstation-step5-r05-calibration.py",
    "art:workstation:step5:r05:check": "node scripts/office-workstation-step5-r05-check.mjs",
    "art:workstation:step5:r05:final": "python scripts/build-office-workstation-step5-r05-final.py",
    "art:workstation:step5:r05:final:check": "node scripts/office-workstation-step5-r05-final-check.mjs",
    "art:workstation:step5:r05:r02": "python scripts/build-office-workstation-step5-r05-r02.py",
    "art:workstation:step5:r05:r02:check": "node scripts/office-workstation-step5-r05-r02-check.mjs",
    "art:workstation:ten-seat:r05:r02": "python scripts/build-office-workstation-ten-seat-r05-r02.py",
    "art:workstation:ten-seat:r05:r02:check": "python scripts/build-office-workstation-ten-seat-r05-r02.py --check && node scripts/office-workstation-ten-seat-r05-r02-check.mjs",
    "art:workstation:authority:check": "node scripts/office-workstation-authority-check.mjs",
    "art:geometry:lock": "node scripts/office-generated-art-lock.mjs --write",
    "art:geometry:generated:check": "node scripts/office-generated-art-lock.mjs --check",
    "art:derived": "python scripts/build-office-derived-assets.py",
    "art:derived:check": "python scripts/build-office-derived-assets.py --check",
    "art:derived:contract:check": "node scripts/office-derived-assets-check.mjs",
    "art:workstation": "python scripts/build-office-workstation-prototype.py",
    "art:workstation:check": "python scripts/build-office-workstation-prototype.py --check",
    "art:library": "python scripts/process-office-source-sheets.py",
    "art:library:check": "python scripts/process-office-source-sheets.py --check",
    "pilot:simulate": "node services/automation-runner/src/simulation/cli.ts",
    "deploy:dry-run": "npm run build --workspace @affiliate-ops/web && npx --yes wrangler@4.113.0 deploy --dry-run --config wrangler.jsonc",
    "deploy:cloudflare": "npm run build --workspace @affiliate-ops/web && npx --yes wrangler@4.113.0 deploy --config wrangler.jsonc",
    "check": "npm run repo:check && npm run art:geometry:check && npm run art:workstation:authority:check && npm run art:workstation:v2:check && npm run art:workstation:step5:check && npm run art:workstation:step5:r03:check && npm run art:workstation:step5:r04:check && npm run art:workstation:step5:r05:check && npm run art:workstation:step5:r05:final:check && npm run art:workstation:step5:r05:r02:check && npm run art:workstation:ten-seat:r05:r02:check && npm run art:derived:contract:check && npm run art:geometry:generated:check && npm run art:prompt:check && npm run architecture:check && npm run code:health && npm run duplicate:check && npm run code:map && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
