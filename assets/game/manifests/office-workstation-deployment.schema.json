{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-workstation-deployment.schema.json",
  "title": "Office workstation deployment presets v1",
  "type": "object",
  "required": ["schemaVersion", "id", "status", "deskFamilyId", "presets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "status": { "const": "staging" },
    "deskFamilyId": { "const": "desk.modular.v1" },
    "presets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "role", "deskFamilyId", "screenThemeId", "equipment"],
        "properties": {
          "id": { "enum": ["standard-single", "standard-dual", "creative-dual-tablet", "noc-dual-status"] },
          "role": { "enum": ["standard", "creative", "noc"] },
          "deskFamilyId": { "const": "desk.modular.v1" },
          "screenThemeId": { "type": "string", "minLength": 1 },
          "equipment": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "assetId", "kind", "slot", "renderRole"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "assetId": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["monitor-shell", "keyboard", "tablet", "phone", "lamp"] },
                "slot": {
                  "type": "object",
                  "required": ["id", "x", "y", "surfaceId"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "x": { "type": "number", "minimum": 0, "exclusiveMaximum": 5 },
                    "y": { "type": "number", "minimum": 0, "exclusiveMaximum": 3 },
                    "surfaceId": { "const": "desk-surface" }
                  },
                  "additionalProperties": false
                },
                "renderRole": { "enum": ["monitor-shell", "surface-equipment"] }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
