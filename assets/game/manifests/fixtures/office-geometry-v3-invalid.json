{
  "version": 1,
  "cases": [
    {
      "name": "floor decal cannot Y-sort",
      "sourceId": "fixture.rug.floor",
      "set": { "sortPivot": { "x": 0.5, "y": 1, "unit": "tile" } },
      "expectedPath": "sortPivot"
    },
    {
      "name": "surface furniture requires a support plane",
      "sourceId": "fixture.desk.surface",
      "set": { "supportPlane": null },
      "expectedPath": "assetType"
    },
    {
      "name": "seat requires a seat slot",
      "sourceId": "fixture.chair.seat",
      "set": { "seatSlots": [] },
      "expectedPath": "seatSlots"
    },
    {
      "name": "wall asset cannot reserve floor cells",
      "sourceId": "fixture.tv.wall",
      "set": { "footprint": { "width": 3, "depth": 1, "unit": "tile" } },
      "expectedPath": "footprint"
    },
    {
      "name": "animated shell pivots must remain stable",
      "sourceId": "fixture.vending.animated",
      "set": { "animation": { "frameCount": 4, "stableBasePivot": false, "stableSortPivot": true } },
      "expectedPath": "animation.stableBasePivot"
    },
    {
      "name": "character owns one floor cell",
      "sourceId": "fixture.agent.character",
      "set": { "footprint": { "width": 2, "depth": 1, "unit": "tile" } },
      "expectedPath": "footprint"
    },
    {
      "name": "attachment slot IDs are unique",
      "sourceId": "fixture.desk.surface",
      "set": {
        "attachmentSlots": [
          { "id": "monitor", "surfaceId": "desk-surface", "x": 2, "y": 0, "unit": "tile" },
          { "id": "monitor", "surfaceId": "desk-surface", "x": 2, "y": 1, "unit": "tile" }
        ]
      },
      "expectedPath": "attachmentSlots[1].id"
    },
    {
      "name": "orientation is explicit and constrained",
      "sourceId": "fixture.plant.upright",
      "set": { "orientation": "diagonal" },
      "expectedPath": "orientation"
    }
  ]
}
