{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-rights.schema.json",
  "title": "Character rights review",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reviewedOn", "records"],
  "properties": {
    "version": { "const": 1 },
    "reviewedOn": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "currentLicenseState",
          "usage",
          "disposition",
          "permittedUse",
          "generationInputAllowed",
          "replacementSlot",
          "reason",
          "reviewStatus"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "currentLicenseState": { "type": "string", "minLength": 1 },
          "usage": {
            "enum": ["active-agent-prototype", "active-companion-prototype", "alternate-prototype"]
          },
          "disposition": { "enum": ["replace-and-quarantine", "retain-with-approved-license"] },
          "permittedUse": { "const": "internal-prototype-only" },
          "generationInputAllowed": { "const": false },
          "replacementSlot": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 },
          "reviewStatus": { "const": "reviewed" }
        }
      }
    }
  }
}
