{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-structure.schema.json",
  "title": "Office structural scene",
  "$defs": {
    "bounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["id", "kind", "bounds", "material", "navigationPolicy", "collisionOwner"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "floor-region" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "material": { "type": "string" },
        "navigationPolicy": { "enum": ["walkable", "restricted"] },
        "collisionOwner": { "const": true }
      }
    },
    {
      "type": "object",
      "required": ["id", "kind", "bounds", "material", "coordinateSpace", "floorYSort"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "wall-segment" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "material": { "type": "string" },
        "coordinateSpace": { "const": "wall-local" },
        "floorYSort": { "const": false }
      }
    },
    {
      "type": "object",
      "required": ["id", "kind", "parentWallId", "opening", "viewport", "frameAssetId", "contentSetId", "floorCollision"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "window-opening" },
        "parentWallId": { "type": "string", "minLength": 1 },
        "opening": { "$ref": "#/$defs/bounds" },
        "viewport": { "$ref": "#/$defs/bounds" },
        "frameAssetId": { "type": "string" },
        "contentSetId": { "type": "string" },
        "floorCollision": { "const": false }
      }
    },
    {
      "type": "object",
      "required": ["id", "kind", "parentWallId", "portalId", "opening", "frameAssetId", "leafAssetId", "state", "floorYSort"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "const": "door-opening" },
        "parentWallId": { "type": "string", "minLength": 1 },
        "portalId": { "type": "string", "minLength": 1 },
        "opening": { "$ref": "#/$defs/bounds" },
        "frameAssetId": { "type": "string" },
        "leafAssetId": { "type": "string" },
        "state": { "enum": ["open", "closed"] },
        "floorYSort": { "const": false }
      }
    }
  ]
}
