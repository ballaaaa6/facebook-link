{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-workstation-bundle-v2.schema.json",
  "title": "Office Workstation Bundle v2 Step 4 bare desk",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "geometrySchemaVersion", "id", "status", "updatedOn", "approvalRecord", "permissions", "source", "deskFamily", "qa"],
  "properties": {
    "version": { "const": 2 },
    "geometrySchemaVersion": { "const": 3 },
    "id": { "const": "office.workstation.bundle.v2" },
    "status": { "const": "step4-accepted" },
    "updatedOn": { "type": "string", "format": "date" },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedOn", "approvedScope", "decision", "nextGate"],
      "properties": {
        "approvedOn": { "type": "string", "format": "date" },
        "approvedScope": { "type": "string", "minLength": 1 },
        "decision": { "const": "accepted" },
        "nextGate": { "type": "string", "minLength": 1 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bareDeskArtwork", "singleSeatAssembly", "tenSeatSceneAssembly", "rendererImplementation", "activeOfficePromotion"],
      "properties": {
        "bareDeskArtwork": { "const": true },
        "singleSeatAssembly": { "const": false },
        "tenSeatSceneAssembly": { "const": false },
        "rendererImplementation": { "const": false },
        "activeOfficePromotion": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "required": ["generationMode", "license", "commercialReviewRequired", "promptFile", "chromaFile", "chromaSha256", "alphaFile", "alphaSha256", "sheetPixels", "cells"],
      "properties": {
        "generationMode": { "const": "built-in-imagegen" },
        "license": { "const": "project-authored-ai-assisted" },
        "commercialReviewRequired": { "const": true },
        "promptFile": { "type": "string", "minLength": 1 },
        "chromaFile": { "type": "string", "minLength": 1 },
        "chromaSha256": { "$ref": "#/$defs/sha256" },
        "alphaFile": { "type": "string", "minLength": 1 },
        "alphaSha256": { "$ref": "#/$defs/sha256" },
        "sheetPixels": { "const": { "width": 1604, "height": 981 } },
        "cells": {
          "type": "object",
          "additionalProperties": false,
          "required": ["front", "back"],
          "properties": {
            "front": { "$ref": "#/$defs/sourceCell" },
            "back": { "$ref": "#/$defs/sourceCell" }
          }
        }
      }
    },
    "deskFamily": {
      "type": "object",
      "required": ["id", "contains", "excludes", "physicalScale", "footprint", "supportPlane", "employeeEdge", "generationRenderBox", "renderBounds", "basePivot", "sortPivot", "normalization", "semanticRows", "orientations"],
      "properties": {
        "id": { "const": "desk.workstation.modern.v2" },
        "contains": { "const": ["bare-desk"] },
        "excludes": { "const": ["monitor", "keyboard", "mouse", "chair", "character", "prop"] },
        "physicalScale": { "const": { "width": 3, "depth": 2, "height": 2.4, "unit": "tile" } },
        "footprint": { "$ref": "#/$defs/footprint" },
        "supportPlane": { "const": { "id": "desk-surface", "width": 3, "depth": 2, "height": 2.4, "unit": "tile" } },
        "employeeEdge": { "type": "null" },
        "generationRenderBox": { "const": { "width": 3, "height": 4, "unit": "tile" } },
        "renderBounds": { "const": { "width": 96, "height": 128, "unit": "authoring-pixel" } },
        "basePivot": { "$ref": "#/$defs/pivot" },
        "sortPivot": { "$ref": "#/$defs/pivot" },
        "normalization": { "type": "object" },
        "semanticRows": { "type": "object" },
        "orientations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["front", "back"],
          "properties": {
            "front": { "$ref": "#/$defs/orientation" },
            "back": { "$ref": "#/$defs/orientation" }
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "required": ["requiredChecks", "reviewOutputs"],
      "properties": {
        "requiredChecks": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string" } },
        "reviewOutputs": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "footprint": { "const": { "width": 3, "depth": 2, "unit": "tile" } },
    "pivot": { "const": { "x": 1.5, "y": 2, "unit": "tile" } },
    "bounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceCell": {
      "type": "object",
      "required": ["sheetBounds", "contentBounds"],
      "properties": {
        "sheetBounds": { "$ref": "#/$defs/bounds" },
        "contentBounds": { "$ref": "#/$defs/bounds" }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compositeAssetId", "compositeFile", "parts"],
      "properties": {
        "compositeAssetId": { "type": "string", "minLength": 1 },
        "compositeFile": { "type": "string", "minLength": 1 },
        "parts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rear", "surface", "base", "foreground"],
          "properties": {
            "rear": { "type": "string", "minLength": 1 },
            "surface": { "type": "string", "minLength": 1 },
            "base": { "type": "string", "minLength": 1 },
            "foreground": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
