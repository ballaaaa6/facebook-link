{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-workstation-bundle.schema.json",
  "title": "Office Workstation Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "geometrySchemaVersion", "id", "status", "deskFamily", "attachmentSlots", "chairFamily", "actorCalibration", "monitorFamily", "screenLoop", "roleVariants", "compositeOrder"],
  "properties": {
    "version": { "const": 1 },
    "geometrySchemaVersion": { "const": 3 },
    "id": { "type": "string", "minLength": 1 },
    "status": { "const": "staging" },
    "deskFamily": {
      "type": "object",
      "required": ["id", "physicalScale", "footprint", "supportPlane", "employeeEdge", "generationRenderBox", "basePivot", "sortPivot", "orientations"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "physicalScale": { "$ref": "#/$defs/canonicalScale" },
        "footprint": { "$ref": "#/$defs/canonicalFootprint" },
        "supportPlane": { "$ref": "#/$defs/canonicalSupport" },
        "employeeEdge": {
          "type": "object",
          "required": ["originY", "depth", "attachmentSlots"],
          "properties": { "originY": { "const": 3 }, "depth": { "const": 1 }, "attachmentSlots": { "const": 0 } }
        },
        "generationRenderBox": {
          "type": "object",
          "required": ["width", "height", "unit"],
          "properties": { "width": { "const": 5 }, "height": { "const": 5 }, "unit": { "const": "tile" } }
        },
        "basePivot": { "$ref": "#/$defs/canonicalPivot" },
        "sortPivot": { "$ref": "#/$defs/canonicalPivot" },
        "orientations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["front", "back", "left", "right"],
          "properties": {
            "front": { "$ref": "#/$defs/deskParts" },
            "back": { "$ref": "#/$defs/deskParts" },
            "left": { "$ref": "#/$defs/deskParts" },
            "right": { "$ref": "#/$defs/deskParts" }
          }
        }
      }
    },
    "attachmentSlots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "surfaceId", "x", "y", "unit", "accepts"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "surfaceId": { "const": "desk-surface" },
          "x": { "type": "number", "minimum": 0, "exclusiveMaximum": 5 },
          "y": { "type": "number", "minimum": 0, "exclusiveMaximum": 3 },
          "unit": { "const": "tile" },
          "accepts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "chairFamily": { "type": "object" },
    "actorCalibration": { "type": "object" },
    "monitorFamily": { "type": "object" },
    "screenLoop": {
      "type": "object",
      "required": ["id", "coordinateSpace", "parentViewportId", "frameAssetIds", "frameDurationMs"],
      "properties": {
        "coordinateSpace": { "const": "viewport-local" },
        "frameAssetIds": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true },
        "frameDurationMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "roleVariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "creative", "noc"],
      "properties": {
        "standard": { "$ref": "#/$defs/roleVariant" },
        "creative": { "$ref": "#/$defs/roleVariant" },
        "noc": { "$ref": "#/$defs/roleVariant" }
      }
    },
    "compositeOrder": {
      "const": ["desk-rear", "desk-surface", "desk-base", "monitor-shell", "monitor-viewport", "surface-equipment", "chair", "actor", "desk-foreground"]
    }
  },
  "$defs": {
    "canonicalScale": {
      "type": "object",
      "required": ["width", "depth", "height", "unit"],
      "properties": { "width": { "const": 5 }, "depth": { "const": 4 }, "height": { "const": 2.4 }, "unit": { "const": "tile" } }
    },
    "canonicalFootprint": {
      "type": "object",
      "required": ["width", "depth", "unit"],
      "properties": { "width": { "const": 5 }, "depth": { "const": 4 }, "unit": { "const": "tile" } }
    },
    "canonicalSupport": {
      "type": "object",
      "required": ["id", "width", "depth", "height", "unit"],
      "properties": { "id": { "const": "desk-surface" }, "width": { "const": 5 }, "depth": { "const": 3 }, "height": { "const": 2.4 }, "unit": { "const": "tile" } }
    },
    "canonicalPivot": {
      "type": "object",
      "required": ["x", "y", "unit"],
      "properties": { "x": { "const": 2.5 }, "y": { "const": 4 }, "unit": { "const": "tile" } }
    },
    "deskParts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rearAssetId", "surfaceAssetId", "baseAssetId", "foregroundAssetId"],
      "properties": {
        "rearAssetId": { "type": "string", "minLength": 1 },
        "surfaceAssetId": { "type": "string", "minLength": 1 },
        "baseAssetId": { "type": "string", "minLength": 1 },
        "foregroundAssetId": { "type": "string", "minLength": 1 }
      }
    },
    "roleVariant": {
      "type": "object",
      "required": ["deskFamilyId", "equipmentProfile", "screenThemeId"],
      "properties": {
        "deskFamilyId": { "const": "desk.modular.v1" },
        "equipmentProfile": { "type": "string", "minLength": 1 },
        "screenThemeId": { "const": "screen.theme.system.loop.v1" }
      }
    }
  }
}
