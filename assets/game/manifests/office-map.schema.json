{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-map.schema.json",
  "title": "Office map",
  "type": "object",
  "oneOf": [
    {
      "not": { "required": ["schemaVersion"] },
      "required": ["id", "gridSize", "width", "height", "surfaces", "zones", "workstations", "companions", "pois", "routes", "navigation", "objects"]
    },
    {
      "required": ["schemaVersion", "id", "status", "activeOfficePromotion", "commercialCharacterApproval", "grid", "structures", "portals", "routes", "workstationDeployments", "acceptance"],
      "properties": { "schemaVersion": { "const": 2 } }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string" },
    "status": { "const": "rejected-geometry" },
    "activeOfficePromotion": { "const": false },
    "commercialCharacterApproval": { "const": false },
    "grid": {
      "type": "object",
      "required": ["width", "height", "tilePixels"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tilePixels": { "type": "integer", "minimum": 8 }
      },
      "additionalProperties": false
    },
    "structures": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "office-structure.schema.json" }
    },
    "portals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "doorOpeningId", "cells", "statePolicy"],
        "properties": {
          "id": { "type": "string" },
          "doorOpeningId": { "type": "string" },
          "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point" } },
          "statePolicy": {
            "type": "object",
            "required": ["open", "closed"],
            "properties": { "open": { "const": "passable" }, "closed": { "const": "blocked" } },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "workstationDeployments": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/workstationDeployment" }
    },
    "acceptance": {
      "type": "object",
      "required": ["requiredDurationSeconds", "sharedSceneClock", "backgroundBitmapAllowed"],
      "properties": {
        "requiredDurationSeconds": { "type": "integer", "minimum": 60 },
        "sharedSceneClock": { "const": true },
        "backgroundBitmapAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "gridSize": { "type": "integer", "minimum": 8 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "surfaces": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/surface" }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "capacity": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "pois": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "activity", "point", "slots", "navNode", "capacity", "duration", "label"],
        "properties": {
          "id": { "type": "string" },
          "activity": { "type": "string" },
          "point": { "$ref": "#/$defs/point" },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/point" }
          },
          "navNode": { "type": "string" },
          "capacity": { "type": "integer", "minimum": 1 },
          "duration": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "character", "home", "route", "dwellSeconds", "speedTilesPerSecond"],
        "properties": {
          "id": { "type": "string" },
          "character": { "type": "string" },
          "home": { "$ref": "#/$defs/point" },
          "route": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/point" }
          },
          "dwellSeconds": { "type": "integer", "minimum": 1 },
          "speedTilesPerSecond": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "navigation": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "y"],
            "properties": {
              "id": { "type": "string" },
              "x": { "type": "integer" },
              "y": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "string" }],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/object" }
    },
    "workstations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "zone", "surfaceId", "desk", "chair", "x", "y", "facing", "seat", "work", "approach", "stand", "navNode", "collision"],
        "properties": {
          "id": { "type": "string" },
          "zone": { "type": "string" },
          "surfaceId": { "type": "string" },
          "desk": { "type": "string" },
          "chair": { "type": "string" },
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "facing": { "enum": ["up", "down", "left", "right"] },
          "seat": { "$ref": "#/$defs/point" },
          "work": { "$ref": "#/$defs/point" },
          "approach": { "$ref": "#/$defs/point" },
          "stand": { "$ref": "#/$defs/point" },
          "navNode": { "type": "string" },
          "previewSide": { "enum": ["auto", "left", "right"] },
          "collision": { "$ref": "#/$defs/rectangle" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } },
      "additionalProperties": false
    },
    "rectangle": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["id", "support", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "support": { "enum": ["floor", "wall", "ceiling"] },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["id", "asset", "layer", "anchor"],
      "oneOf": [
        {
          "required": ["x", "y", "surfaceId"],
          "not": {
            "anyOf": [
              { "required": ["parentId"] },
              { "required": ["slot"] }
            ]
          }
        },
        {
          "required": ["parentId", "slot"],
          "not": {
            "anyOf": [
              { "required": ["x"] },
              { "required": ["y"] },
              { "required": ["surfaceId"] }
            ]
          }
        }
      ],
      "properties": {
        "id": { "type": "string" },
        "asset": { "type": "string" },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "surfaceId": { "type": "string" },
        "parentId": { "type": "string" },
        "slot": { "type": "string" },
        "layer": { "enum": ["wall", "furniture", "equipment", "decor"] },
        "anchor": { "enum": ["center", "bottom-center", "wall-top", "wall-right"] }
      },
      "additionalProperties": false
    },
    "workstationDeployment": {
      "type": "object",
      "required": ["id", "agentId", "presetId", "role", "deskFamilyId", "orientation", "facing", "floorRegionId", "footprint", "supportPlane", "seat", "approach", "stand", "basePivot", "sortPivot"],
      "properties": {
        "id": { "type": "string" },
        "agentId": { "type": "string" },
        "presetId": { "enum": ["standard-single", "standard-dual", "creative-dual-tablet", "noc-dual-status"] },
        "role": { "enum": ["standard", "creative", "noc"] },
        "deskFamilyId": { "const": "desk.modular.v1" },
        "orientation": { "enum": ["front", "back"] },
        "facing": { "enum": ["down", "up"] },
        "floorRegionId": { "type": "string" },
        "footprint": { "$ref": "#/$defs/deploymentFootprint" },
        "supportPlane": { "$ref": "#/$defs/deploymentSupportPlane" },
        "seat": { "$ref": "#/$defs/deploymentSeat" },
        "approach": { "$ref": "#/$defs/numberPoint" },
        "stand": { "$ref": "#/$defs/numberPoint" },
        "basePivot": { "$ref": "#/$defs/numberPoint" },
        "sortPivot": { "$ref": "#/$defs/numberPoint" }
      },
      "additionalProperties": false
    },
    "numberPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": false
    },
    "deploymentFootprint": {
      "type": "object",
      "required": ["x", "y", "width", "depth"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "const": 5 },
        "depth": { "const": 4 }
      },
      "additionalProperties": false
    },
    "deploymentSupportPlane": {
      "type": "object",
      "required": ["id", "x", "y", "width", "depth"],
      "properties": {
        "id": { "const": "desk-surface" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "const": 5 },
        "depth": { "const": 3 }
      },
      "additionalProperties": false
    },
    "deploymentSeat": {
      "type": "object",
      "required": ["x", "y", "width", "depth"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "const": 1 },
        "depth": { "const": 1 }
      },
      "additionalProperties": false
    }
  }
}
