{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-asset-geometry.schema.json",
  "title": "Office Asset Geometry v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "assetType",
    "placementPlane",
    "physicalScale",
    "footprint",
    "supportPlane",
    "basePivot",
    "sortPivot",
    "renderBounds",
    "renderOffset",
    "verticalExtension",
    "occlusionParts",
    "attachmentSlots",
    "seatSlots",
    "orientation"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "type": "string", "minLength": 1 },
    "assetType": {
      "enum": [
        "floor-decal",
        "upright-floor-object",
        "surface-furniture",
        "seat",
        "wall-mounted",
        "structural-opening",
        "animated-shell",
        "character"
      ]
    },
    "placementPlane": {
      "enum": ["floor", "wall", "ceiling", "furniture-surface"]
    },
    "physicalScale": { "$ref": "#/$defs/physicalScale" },
    "footprint": {
      "oneOf": [{ "$ref": "#/$defs/rectangle" }, { "type": "null" }]
    },
    "supportPlane": {
      "oneOf": [{ "$ref": "#/$defs/supportPlane" }, { "type": "null" }]
    },
    "basePivot": {
      "oneOf": [{ "$ref": "#/$defs/tilePoint" }, { "type": "null" }]
    },
    "sortPivot": {
      "oneOf": [{ "$ref": "#/$defs/tilePoint" }, { "type": "null" }]
    },
    "renderBounds": { "$ref": "#/$defs/renderBounds" },
    "renderOffset": { "$ref": "#/$defs/renderOffset" },
    "verticalExtension": { "$ref": "#/$defs/verticalExtension" },
    "occlusionParts": {
      "type": "array",
      "items": { "$ref": "#/$defs/occlusionPart" }
    },
    "attachmentSlots": {
      "type": "array",
      "items": { "$ref": "#/$defs/attachmentSlot" }
    },
    "seatSlots": {
      "type": "array",
      "items": { "$ref": "#/$defs/seatSlot" }
    },
    "orientation": {
      "enum": ["none", "front", "back", "left", "right"]
    },
    "animation": { "$ref": "#/$defs/animation" }
  },
  "allOf": [
    {
      "if": { "properties": { "assetType": { "const": "floor-decal" } } },
      "then": {
        "properties": {
          "placementPlane": { "const": "floor" },
          "footprint": { "type": "null" },
          "supportPlane": { "type": "null" },
          "basePivot": { "type": "null" },
          "sortPivot": { "type": "null" },
          "attachmentSlots": { "maxItems": 0 },
          "seatSlots": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "assetType": { "const": "upright-floor-object" } } },
      "then": {
        "oneOf": [
          {
            "properties": {
              "placementPlane": { "const": "floor" },
              "footprint": { "$ref": "#/$defs/rectangle" },
              "basePivot": { "$ref": "#/$defs/tilePoint" },
              "sortPivot": { "$ref": "#/$defs/tilePoint" }
            }
          },
          {
            "properties": {
              "placementPlane": { "const": "furniture-surface" },
              "footprint": { "type": "null" },
              "basePivot": { "$ref": "#/$defs/tilePoint" },
              "sortPivot": { "type": "null" }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "assetType": { "const": "surface-furniture" } } },
      "then": {
        "properties": {
          "placementPlane": { "const": "floor" },
          "footprint": { "$ref": "#/$defs/rectangle" },
          "supportPlane": { "$ref": "#/$defs/supportPlane" },
          "basePivot": { "$ref": "#/$defs/tilePoint" },
          "sortPivot": { "$ref": "#/$defs/tilePoint" }
        }
      }
    },
    {
      "if": { "properties": { "assetType": { "const": "seat" } } },
      "then": {
        "properties": {
          "placementPlane": { "const": "floor" },
          "footprint": { "$ref": "#/$defs/rectangle" },
          "basePivot": { "$ref": "#/$defs/tilePoint" },
          "sortPivot": { "$ref": "#/$defs/tilePoint" },
          "seatSlots": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assetType": {
            "enum": ["wall-mounted", "structural-opening"]
          }
        }
      },
      "then": {
        "properties": {
          "placementPlane": { "const": "wall" },
          "footprint": { "type": "null" },
          "basePivot": { "$ref": "#/$defs/tilePoint" },
          "sortPivot": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "assetType": { "const": "animated-shell" } } },
      "then": { "required": ["animation"] }
    },
    {
      "if": { "properties": { "assetType": { "const": "character" } } },
      "then": {
        "properties": {
          "placementPlane": { "const": "floor" },
          "footprint": {
            "properties": {
              "width": { "const": 1 },
              "depth": { "const": 1 }
            }
          },
          "basePivot": { "$ref": "#/$defs/tilePoint" },
          "sortPivot": { "$ref": "#/$defs/tilePoint" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "physicalScale": {
      "type": "object",
      "required": ["width", "depth", "height", "unit"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "unit": { "const": "tile" }
      },
      "additionalProperties": false
    },
    "rectangle": {
      "type": "object",
      "required": ["width", "depth", "unit"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "const": "tile" }
      },
      "additionalProperties": false
    },
    "tilePoint": {
      "type": "object",
      "required": ["x", "y", "unit"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "unit": { "const": "tile" }
      },
      "additionalProperties": false
    },
    "supportPlane": {
      "type": "object",
      "required": ["id", "width", "depth", "height", "unit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "const": "tile" }
      },
      "additionalProperties": false
    },
    "renderBounds": {
      "type": "object",
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "const": "authoring-pixel" }
      },
      "additionalProperties": false
    },
    "renderOffset": {
      "type": "object",
      "required": ["x", "y", "unit"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "unit": { "const": "authoring-pixel" }
      },
      "additionalProperties": false
    },
    "verticalExtension": {
      "type": "object",
      "required": ["aboveBase", "belowBase", "unit"],
      "properties": {
        "aboveBase": { "type": "number", "minimum": 0 },
        "belowBase": { "type": "number", "minimum": 0 },
        "unit": { "const": "tile" }
      },
      "additionalProperties": false
    },
    "occlusionPart": {
      "type": "object",
      "required": ["id", "role", "assetId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["rear", "base", "foreground"] },
        "assetId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "attachmentSlot": {
      "type": "object",
      "required": ["id", "surfaceId", "x", "y", "unit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "surfaceId": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "unit": { "const": "tile" }
      },
      "additionalProperties": false
    },
    "seatSlot": {
      "type": "object",
      "required": ["id", "x", "y", "unit", "facing"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "unit": { "const": "tile" },
        "facing": { "enum": ["front", "back", "left", "right"] }
      },
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "required": ["frameCount", "stableBasePivot", "stableSortPivot"],
      "properties": {
        "frameCount": { "type": "integer", "minimum": 2 },
        "stableBasePivot": { "const": true },
        "stableSortPivot": { "const": true }
      },
      "additionalProperties": false
    }
  }
}
