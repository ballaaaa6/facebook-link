{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "office-derived-assets.schema.json",
  "title": "Office Derived Assets v1",
  "type": "object",
  "required": [
    "version",
    "geometrySchemaVersion",
    "status",
    "activeOfficePromotion",
    "auditSource",
    "sourcePolicy",
    "counts",
    "records",
    "qa"
  ],
  "properties": {
    "version": { "const": 1 },
    "geometrySchemaVersion": { "const": 3 },
    "status": { "const": "accepted-staging" },
    "activeOfficePromotion": { "const": false },
    "auditSource": { "type": "string", "minLength": 1 },
    "sourcePolicy": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "required": ["total", "byWave", "cleanup", "composites", "verifiedNoopCleanup"],
      "properties": {
        "total": { "const": 77 },
        "byWave": {
          "type": "object",
          "required": ["step-13", "step-14", "step-15", "step-16"],
          "properties": {
            "step-13": { "const": 24 },
            "step-14": { "const": 40 },
            "step-15": { "const": 6 },
            "step-16": { "const": 7 }
          },
          "additionalProperties": false
        },
        "cleanup": { "const": 64 },
        "composites": { "const": 13 },
        "verifiedNoopCleanup": { "type": "integer", "minimum": 0, "maximum": 64 }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 77,
      "maxItems": 77,
      "items": { "$ref": "#/$defs/record" }
    },
    "qa": {
      "type": "object",
      "required": ["step-13", "step-14", "step-15", "step-16"],
      "properties": {
        "step-13": { "type": "string" },
        "step-14": { "type": "string" },
        "step-15": { "type": "string" },
        "step-16": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "record": {
      "type": "object",
      "required": ["recordId", "assetId", "wave", "operation", "status", "source", "recipe", "metrics", "outputs", "geometry"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "wave": { "enum": ["step-13", "step-14", "step-15", "step-16"] },
        "operation": {
          "enum": [
            "clean-largest-component-bounds",
            "verified-noop-cleanup",
            "foreground-overlay-composite",
            "semantic-structural-composite"
          ]
        },
        "status": { "const": "accepted-staging" },
        "source": { "$ref": "#/$defs/source" },
        "recipe": { "$ref": "#/$defs/recipe" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/output" }
        },
        "geometry": {
          "oneOf": [
            { "$ref": "office-asset-geometry.schema.json" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["file", "sha256", "width", "height", "alphaPixels", "licenseState"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alphaPixels": { "type": "integer", "minimum": 0 },
        "licenseState": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": ["keepBox", "foregroundRegions"],
      "properties": {
        "keepBox": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 0 },
                { "type": "integer", "minimum": 1 },
                { "type": "integer", "minimum": 1 }
              ],
              "minItems": 4,
              "maxItems": 4
            },
            { "type": "null" }
          ]
        },
        "foregroundRegions": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ],
            "minItems": 4,
            "maxItems": 4
          }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["retainedAlphaPixels", "removedAlphaPixels"],
      "properties": {
        "retainedAlphaPixels": { "type": "integer", "minimum": 0 },
        "removedAlphaPixels": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["role", "file", "sha256", "width", "height", "alphaPixels"],
      "properties": {
        "role": { "enum": ["clean", "base", "foreground"] },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alphaPixels": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
