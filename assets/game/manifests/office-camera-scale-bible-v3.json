{
  "version": 3,
  "geometrySchemaVersion": 5,
  "id": "office.camera-scale-bible.v3",
  "status": "owner-calibration-review",
  "updatedOn": "2026-07-28",
  "revises": {
    "file": "assets/game/manifests/office-camera-scale-bible.json",
    "scope": "Step 5 workstation spatial semantics only",
    "historicalRuleStatus": "Step 4 desk-art evidence; forbidden as Step 5 assembly authority"
  },
  "permissions": {
    "deterministicMeasurement": true,
    "calibrationBoards": true,
    "artworkGeneration": false,
    "rendererImplementation": false,
    "singleSeatAssembly": false,
    "tenSeatAssembly": false,
    "activeOfficePromotion": false
  },
  "world": {
    "tilePixels": 32,
    "axes": {
      "x": "increases-right",
      "y": "increases-toward-viewer",
      "z": "increases-up"
    },
    "projection": {
      "screenX": "worldX * 32",
      "screenY": "worldY * 32 - worldZ * 32",
      "perspective": false,
      "pixelSnap": "integer"
    },
    "levels": {
      "floor": 0,
      "chairSeat": 1,
      "deskSupport": 2,
      "personTop": 3
    }
  },
  "standards": {
    "person": {
      "floorFootprint": { "width": 1, "depth": 1 },
      "logicalVolume": { "width": 1, "depth": 1, "height": 3 },
      "currentOfficeFramePixels": { "width": 96, "height": 104 },
      "visualOverflowAllowed": true,
      "perCharacterScaleOverrides": false
    },
    "chair": {
      "floorFootprint": { "width": 1, "depth": 1 },
      "logicalVolume": { "width": 1, "depth": 1, "height": 2 },
      "seatLevel": 1,
      "sharesFloorCellWithSeatedPerson": true,
      "renderEnvelope": "unlocked-pending-owner-contact-approval"
    },
    "desk": {
      "floorFootprint": { "width": 3, "depth": 2 },
      "logicalVolume": { "width": 3, "depth": 2, "height": 2 },
      "supportPlane": { "width": 3, "depth": 2, "z": 2 },
      "requiredSupportPixels": { "width": 96, "depth": 64 },
      "futureRenderCanvasPixels": { "width": 96, "height": 128 }
    }
  },
  "rules": [
    "Logical footprint controls occupancy; visible pixels may overflow only when explicitly declared.",
    "Furniture height never creates an extra floor row.",
    "A seated person and chair reserve the same one-tile floor cell.",
    "The complete desk support plane is three tiles wide and two tiles deep.",
    "No asset or renderer implementation may begin until the R03 calibration gate is approved."
  ]
}
