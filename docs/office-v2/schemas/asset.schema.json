{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/asset.schema.json",
  "title": "Office V2 Asset Family",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "familyId", "familyVersion", "projectionId", "source", "geometry", "render", "orientations", "variants", "approval"],
  "properties": {
    "schemaVersion": { "const": "office-asset-v1" },
    "familyId": { "$ref": "common.schema.json#/$defs/id" },
    "familyVersion": { "type": "integer", "minimum": 1 },
    "projectionId": { "const": "office-projection-v1" },
    "source": { "$ref": "provenance.schema.json#/$defs/record" },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas", "footprint", "anchor", "spriteOrigin", "groundContact", "visualHeightPx", "sockets"],
      "properties": {
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widthPx", "heightPx"],
          "properties": {
            "widthPx": { "type": "integer", "minimum": 1 },
            "heightPx": { "type": "integer", "minimum": 1 }
          }
        },
        "footprint": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/cell" }
        },
        "anchor": { "$ref": "common.schema.json#/$defs/position" },
        "spriteOrigin": { "$ref": "common.schema.json#/$defs/spritePoint" },
        "groundContact": { "$ref": "common.schema.json#/$defs/spritePoint" },
        "visualHeightPx": { "type": "integer", "minimum": 1 },
        "sockets": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/socket" }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band", "pixelDensity", "filtering", "splitMode"],
      "properties": {
        "band": { "$ref": "common.schema.json#/$defs/renderBand" },
        "pixelDensity": { "type": "integer", "minimum": 1 },
        "filtering": { "const": "nearest" },
        "splitMode": { "enum": ["single", "lower-upper"] }
      }
    },
    "orientations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/direction" }
    },
    "connectivityFamilyId": { "$ref": "common.schema.json#/$defs/id" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "sha256", "orientation", "widthPx", "heightPx"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "file": { "type": "string", "pattern": "^[a-z0-9/_-]+\\.png$" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "orientation": { "$ref": "common.schema.json#/$defs/direction" },
          "neighborMask": { "type": "integer", "minimum": 0, "maximum": 15 },
          "widthPx": { "type": "integer", "minimum": 1 },
          "heightPx": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "visual", "commercial"],
      "properties": {
        "geometry": { "const": "approved" },
        "visual": { "const": "approved" },
        "commercial": { "const": "approved" }
      }
    }
  }
}
