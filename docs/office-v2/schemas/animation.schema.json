{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/animation.schema.json",
  "title": "Office V2 Animation Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "animationSetId", "animationSetVersion", "facings", "mirrorPolicy", "clips"],
  "properties": {
    "schemaVersion": { "const": "office-animation-v1" },
    "animationSetId": { "$ref": "common.schema.json#/$defs/id" },
    "animationSetVersion": { "type": "integer", "minimum": 1 },
    "facings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/direction" }
    },
    "mirrorPolicy": { "enum": ["none", "east-west"] },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "semanticState", "facing", "frames", "loop"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "semanticState": { "enum": ["idle", "move", "interact", "blocked"] },
          "facing": { "$ref": "common.schema.json#/$defs/direction" },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variantId", "durationMs"],
              "properties": {
                "variantId": { "$ref": "common.schema.json#/$defs/id" },
                "durationMs": { "type": "integer", "minimum": 1 },
                "presentationEvent": { "$ref": "common.schema.json#/$defs/id" }
              }
            }
          },
          "loop": { "type": "boolean" }
        }
      }
    }
  }
}
