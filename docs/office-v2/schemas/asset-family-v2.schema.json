{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/asset-family-v2.schema.json",
  "title": "Office V2 Reference-Only Asset Family",
  "$defs": {
    "versionedSlugReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" }
      }
    },
    "assetFamilyDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "familyId", "familyVersion", "projectionId", "styleProfileRef",
        "geometryRef", "sourceSetRef", "exportRecipeRef", "reviewRef", "spriteFrameRefs",
        "renderPartRefs", "semanticVariantRefs", "admission"
      ],
      "properties": {
        "schemaVersion": { "const": "office-asset-family-v2" },
        "familyId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "familyVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "projectionId": { "const": "office-projection-v1" },
        "styleProfileRef": { "$ref": "#/$defs/versionedSlugReference" },
        "geometryRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/geometryReference" },
        "sourceSetRef": { "$ref": "#/$defs/versionedSlugReference" },
        "exportRecipeRef": { "$ref": "#/$defs/versionedSlugReference" },
        "reviewRef": { "$ref": "#/$defs/versionedSlugReference" },
        "spriteFrameRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/versionedSlugReference" } },
        "renderPartRefs": { "type": "array", "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/renderPartReference" } },
        "semanticVariantRefs": { "type": "array", "items": { "$ref": "#/$defs/versionedSlugReference" } },
        "connectivityFamilyRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/connectivityFamilyReference" },
        "admission": { "enum": ["spec-only", "runtime-approved"] },
        "trimmingPolicy": { "const": "forbidden-v1" }
      }
    }
  },
  "$ref": "#/$defs/assetFamilyDocument"
}
