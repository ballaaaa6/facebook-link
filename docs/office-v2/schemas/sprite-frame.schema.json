{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/sprite-frame.schema.json",
  "title": "Office V2 Sprite Frame Registration",
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "xPx", "yPx"],
      "properties": {
        "space": { "const": "sprite-pixel" },
        "xPx": { "type": "integer", "minimum": 0 },
        "yPx": { "type": "integer", "minimum": 0 }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xPx", "yPx", "widthPx", "heightPx"],
      "properties": {
        "xPx": { "type": "integer", "minimum": 0 },
        "yPx": { "type": "integer", "minimum": 0 },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 }
      }
    },
    "versionedSlugReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" }
      }
    },
    "spriteFrameDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "frameId", "frameVersion", "assetFamilyRef", "geometryRef",
        "orientation", "canvas", "frameBounds", "spriteOrigin", "groundContact",
        "visualHeightPx", "trimmingPolicy", "alphaPolicy", "renderPartRefs", "semanticPickOwner"
      ],
      "properties": {
        "schemaVersion": { "const": "office-sprite-frame-v1" },
        "frameId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "frameVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "assetFamilyRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/assetFamilyReference" },
        "geometryRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/geometryReference" },
        "orientation": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/worldFacing" },
        "canvas": { "$ref": "#/$defs/rect" },
        "frameBounds": { "$ref": "#/$defs/rect" },
        "spriteOrigin": { "$ref": "#/$defs/point" },
        "groundContact": { "$ref": "#/$defs/point" },
        "depthContact": { "$ref": "#/$defs/point" },
        "visualHeightPx": { "type": "integer", "minimum": 1 },
        "trimmingPolicy": { "const": "forbidden-v1" },
        "alphaPolicy": { "enum": ["opaque-or-transparent", "validated-semitransparent"] },
        "renderPartRefs": { "type": "array", "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/renderPartReference" } },
        "semanticPickOwner": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" }
      }
    }
  },
  "$ref": "#/$defs/spriteFrameDocument"
}
