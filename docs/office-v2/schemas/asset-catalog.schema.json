{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/asset-catalog.schema.json",
  "title": "Office V2 Asset Catalog",
  "$defs": {
    "versionedSlugReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "familyRef", "variantId", "frameRef", "atlasRef", "geometryRef", "runtimePath", "sha256", "lifecycleGroup", "admission"],
      "properties": {
        "entryId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "familyRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/assetFamilyReference" },
        "variantId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "frameRef": { "$ref": "#/$defs/versionedSlugReference" },
        "atlasRef": { "$ref": "#/$defs/versionedSlugReference" },
        "geometryRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/geometryReference" },
        "runtimePath": { "type": "string", "pattern": "^office-v2/runtime/[a-z0-9/_-]+\\.png$" },
        "sha256": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "lifecycleGroup": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "admission": { "enum": ["spec-only", "runtime-approved"] }
      }
    },
    "assetCatalogDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "catalogId", "catalogVersion", "atlasRefs", "entries", "missingAssetPolicy", "admission"],
      "properties": {
        "schemaVersion": { "const": "office-asset-catalog-v1" },
        "catalogId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "catalogVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "atlasRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/versionedSlugReference" } },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
        "missingAssetPolicy": { "const": "fail-closed" },
        "admission": { "enum": ["spec-only", "runtime-approved"] }
      }
    }
  },
  "$ref": "#/$defs/assetCatalogDocument"
}
