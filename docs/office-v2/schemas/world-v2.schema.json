{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/world-v2.schema.json",
  "title": "Office V2 Renderer-Neutral Floor World",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "building",
    "floor",
    "world",
    "bounds",
    "compositionProfile",
    "rooms",
    "actorCapacity",
    "actorSlots",
    "entities",
    "reservedCores",
    "portals"
  ],
  "properties": {
    "schemaVersion": { "const": "office-world-v2-v1" },
    "building": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/buildingReference" },
    "floor": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorReference" },
    "world": { "$ref": "#/$defs/worldReference" },
    "bounds": { "$ref": "#/$defs/bounds" },
    "compositionProfile": { "enum": ["operations", "review"] },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/roomReference" }
    },
    "actorCapacity": { "$ref": "#/$defs/actorCapacity" },
    "actorSlots": {
      "type": "array",
      "items": { "$ref": "#/$defs/actorSlot" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/worldEntity" }
    },
    "reservedCores": {
      "type": "array",
      "items": { "$ref": "#/$defs/reservedCore" }
    },
    "portals": {
      "type": "array",
      "items": { "$ref": "#/$defs/portalReference" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "worldReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "maxElevation"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "depth": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxElevation": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "worldDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "building", "floor", "world", "bounds", "compositionProfile", "rooms", "actorCapacity", "actorSlots", "entities", "reservedCores", "portals"],
      "properties": {
        "schemaVersion": { "const": "office-world-v2-v1" },
        "building": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/buildingReference" },
        "floor": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorReference" },
        "world": { "$ref": "#/$defs/worldReference" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "compositionProfile": { "enum": ["operations", "review"] },
        "rooms": { "type": "array", "minItems": 1, "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/roomReference" } },
        "actorCapacity": { "$ref": "#/$defs/actorCapacity" },
        "actorSlots": { "type": "array", "items": { "$ref": "#/$defs/actorSlot" } },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } },
        "reservedCores": { "type": "array", "items": { "$ref": "#/$defs/reservedCore" } },
        "portals": { "type": "array", "items": { "$ref": "#/$defs/portalReference" } }
      }
    },
    "actorCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assigned", "reserved", "maximum"],
      "properties": {
        "assigned": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "reserved": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maximum": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "actorSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assignment", "floor"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "assignment": { "enum": ["assigned", "reserved"] },
        "floor": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorReference" },
        "facilityId": { "$ref": "#/$defs/slug" },
        "roleId": { "$ref": "#/$defs/slug" }
      }
    },
    "worldEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "semantic", "floor", "occupiedCells", "blocking"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "enum": ["facility", "reserved-core"] },
        "semantic": { "enum": ["work", "review", "reliability", "pantry", "lounge", "stair", "lift", "other"] },
        "floor": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorReference" },
        "occupiedCells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorLocalCellPosition" }
        },
        "blocking": { "type": "boolean" }
      }
    },
    "reservedCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "floor", "cells"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "enum": ["stair", "lift"] },
        "floor": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorReference" },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorLocalCellPosition" }
        }
      }
    },
    "portalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "version": { "$ref": "#/$defs/positiveVersion" },
        "kind": { "enum": ["entrance", "vertical"] }
      }
    }
  }
}
