{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/simulation-trace-v2.schema.json",
  "title": "Office V2 Simulation Trace V2",
  "$defs": {
    "stateHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "stateHash"],
      "properties": {
        "tick": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "stateHash": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" }
      }
    },
    "traceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "traceId", "engineVersion", "initialSnapshot", "inputs", "results", "events", "stateHashes", "finalStateHash"],
      "properties": {
        "schemaVersion": { "const": "office-simulation-trace-v2" },
        "traceId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/traceId" },
        "engineVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "initialSnapshot": { "$ref": "https://affiliate-operations.example/schemas/office-v2/simulation-snapshot-v2.schema.json#/$defs/snapshotDocument" },
        "inputs": { "type": "array", "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/simulation-snapshot-v2.schema.json#/$defs/externalInput" } },
        "results": { "type": "array", "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/simulation-result.schema.json#/$defs/resultDocument" } },
        "events": { "type": "array", "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/simulation-event.schema.json#/$defs/eventDocument" } },
        "stateHashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateHash" } },
        "finalStateHash": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" }
      }
    }
  },
  "$ref": "#/$defs/traceDocument"
}
