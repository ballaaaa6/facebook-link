{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/presentation-snapshot.schema.json",
  "title": "Office V2 Immutable Presentation Snapshot",
  "$defs": {
    "worldReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" }, "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" } }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromVersion", "effect"],
      "properties": {
        "fromVersion": { "const": "office-presentation-snapshot-v0" },
        "effect": { "const": "reject-and-rehash" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["floor", "position"],
      "properties": {
        "floor": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorReference" },
        "position": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/floorLocalSubCellPosition" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "transform", "semanticState", "renderParts", "label", "selection", "freshness"],
      "properties": {
        "entityId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/entityInstanceId" },
        "transform": { "$ref": "#/$defs/transform" },
        "semanticState": { "enum": ["working", "waiting", "review", "blocked", "unavailable", "idle"] },
        "renderParts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" } },
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected", "focused"],
          "properties": { "selected": { "type": "boolean" }, "focused": { "type": "boolean" } }
        },
        "freshness": { "enum": ["live", "stale", "reconnecting", "unavailable"] }
      }
    },
    "snapshotDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "snapshotId", "world", "tick", "worldHash", "entities", "migration"],
      "properties": {
        "schemaVersion": { "const": "office-presentation-snapshot-v1" },
        "snapshotId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/snapshotId" },
        "world": { "$ref": "#/$defs/worldReference" },
        "tick": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "worldHash": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "migration": { "$ref": "#/$defs/migration" }
      }
    }
  },
  "$ref": "#/$defs/snapshotDocument"
}
