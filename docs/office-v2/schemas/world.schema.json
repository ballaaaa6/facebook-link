{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/world.schema.json",
  "title": "Office V2 World Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "worldId", "projection", "tickRateHz", "bounds", "zones", "surfaces", "structures", "entities"],
  "properties": {
    "schemaVersion": { "const": "office-world-v1" },
    "worldId": { "$ref": "common.schema.json#/$defs/id" },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subCellUnits", "tileWidthPx", "tileHeightPx", "elevationHeightPx", "cameraRotation"],
      "properties": {
        "id": { "const": "office-projection-v1" },
        "subCellUnits": { "const": 4 },
        "tileWidthPx": { "const": 64 },
        "tileHeightPx": { "const": 32 },
        "elevationHeightPx": { "const": 16 },
        "cameraRotation": { "const": 0 }
      }
    },
    "tickRateHz": { "const": 10 },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "maxElevation"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "depth": { "type": "integer", "minimum": 1 },
        "maxElevation": { "type": "integer", "minimum": 0 }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "cells"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["work", "review", "circulation", "service", "quiet"] },
          "priority": { "type": "integer", "minimum": 0 },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/cell" }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cell", "kind", "elevation", "supports", "traversalCost"],
        "properties": {
          "cell": { "$ref": "common.schema.json#/$defs/cell" },
          "kind": { "$ref": "common.schema.json#/$defs/id" },
          "elevation": { "type": "integer", "minimum": 0 },
          "supports": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["actor", "furniture", "facility", "structure"] }
          },
          "traversalCost": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definitionId", "ownerCell", "edge", "state"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "definitionId": { "$ref": "common.schema.json#/$defs/id" },
          "ownerCell": { "$ref": "common.schema.json#/$defs/cell" },
          "edge": { "enum": ["north", "west"] },
          "state": { "enum": ["solid", "open", "closed", "locked", "unavailable"] }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definitionId", "anchor", "orientation"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "definitionId": { "$ref": "common.schema.json#/$defs/id" },
          "anchor": { "$ref": "common.schema.json#/$defs/position" },
          "orientation": { "$ref": "common.schema.json#/$defs/direction" },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/id" }
          }
        }
      }
    }
  }
}
