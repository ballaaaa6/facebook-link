{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/source-set.schema.json",
  "title": "Office V2 Immutable Source Set",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId", "file", "sha256", "immutable", "kind", "authoringMethod",
        "authorOrTool", "createdAt", "licenseStatus", "commercialStatus", "creationBrief"
      ],
      "properties": {
        "sourceId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "file": { "type": "string", "pattern": "^office-v2/sources/[a-z0-9/_-]+\\.[a-z0-9]+$" },
        "sha256": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "immutable": { "const": true },
        "kind": { "enum": ["layer", "concept", "reference-metadata", "source-project"] },
        "authoringMethod": { "enum": ["hand-drawn", "generated-assisted", "licensed-third-party"] },
        "authorOrTool": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "licenseStatus": { "enum": ["project-owned", "licensed"] },
        "commercialStatus": { "enum": ["approved", "pending-review", "rejected"] },
        "creationBrief": { "type": "string", "minLength": 1 }
      }
    },
    "versionedSlugReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" }
      }
    },
    "sourceSetDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sourceSetId", "sourceSetVersion", "familyRef", "sources", "recipeRef", "sourceOrder"],
      "properties": {
        "schemaVersion": { "const": "office-source-set-v1" },
        "sourceSetId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "sourceSetVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "familyRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/assetFamilyReference" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "recipeRef": { "$ref": "#/$defs/versionedSlugReference" },
        "sourceOrder": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" } }
      }
    }
  },
  "$ref": "#/$defs/sourceSetDocument"
}
