{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/simulation-result.schema.json",
  "title": "Office V2 Simulation Command Result",
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "owner", "version", "message", "pointers"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "owner": { "enum": ["contract", "simulation", "interaction", "navigation"] },
        "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "message": { "type": "string", "minLength": 1 },
        "pointers": { "type": "array", "items": { "type": "string", "pattern": "^(/|$)" } }
      }
    },
    "resultDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resultId", "commandId", "tick", "status", "stateChanged", "payloadDigest"],
      "properties": {
        "schemaVersion": { "const": "office-simulation-result-v2" },
        "resultId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/resultId" },
        "commandId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/commandId" },
        "tick": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "status": { "enum": ["accepted", "rejected", "idempotent-duplicate"] },
        "stateChanged": { "type": "boolean" },
        "payloadDigest": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "diagnostic": { "$ref": "#/$defs/diagnostic" }
      }
    }
  },
  "$ref": "#/$defs/resultDocument"
}
