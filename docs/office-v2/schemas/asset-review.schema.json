{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/asset-review.schema.json",
  "title": "Office V2 Asset Review",
  "$defs": {
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boardId", "kind", "path", "sha256", "generatedFrom", "reviewed"],
      "properties": {
        "boardId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "kind": { "enum": ["neutral-geometry", "alpha-edge", "palette", "light-shadow", "contact-sheet", "composite"] },
        "path": { "type": "string", "pattern": "^office-v2/reviews/[a-z0-9/_-]+\\.(json|md|png)$" },
        "sha256": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "generatedFrom": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "reviewed": { "type": "boolean" }
      }
    },
    "assetReviewDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "reviewId", "reviewVersion", "familyRef", "boards", "approvals", "outcome"],
      "properties": {
        "schemaVersion": { "const": "office-asset-review-v1" },
        "reviewId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "reviewVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "familyRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/assetFamilyReference" },
        "boards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/board" } },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["geometry", "visual", "commercial"],
          "properties": {
            "geometry": { "enum": ["pending", "approved", "rejected"] },
            "visual": { "enum": ["pending", "approved", "rejected"] },
            "commercial": { "enum": ["pending", "approved", "rejected"] }
          }
        },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["pending-owner-review", "approved", "rejected"] }
      }
    }
  },
  "$ref": "#/$defs/assetReviewDocument"
}
