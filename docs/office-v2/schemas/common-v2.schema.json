{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json",
  "title": "Office V2 Common Identity and Coordinate Types",
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonNegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "finiteNumber": {
      "type": "number",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identityKind": {
      "enum": [
        "building",
        "floor",
        "room",
        "entity-definition",
        "entity-instance",
        "facility",
        "actor",
        "task",
        "workflow-run",
        "socket",
        "command",
        "result",
        "event",
        "intent",
        "tick",
        "action",
        "queue-ticket",
        "reservation",
        "snapshot",
        "trace",
        "external-input",
        "world-revision",
        "geometry",
        "definition-bundle",
        "use-slot",
        "interaction",
        "asset-family",
        "render-part",
        "character-profile",
        "animation-set",
        "animation-clip",
        "connectivity-family",
        "connectivity-variant"
      ]
    },
    "buildingId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "building" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "floorId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "floor" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "roomId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "room" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "entityDefinitionId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "entity-definition" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "entityInstanceId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "entity-instance" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "facilityId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "facility" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "actorId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "actor" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "taskId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "task" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "workflowRunId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "workflow-run" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "socketId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "socket" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "geometryId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "geometry" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "definitionBundleId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "definition-bundle" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "useSlotId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "use-slot" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "interactionId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "interaction" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "assetFamilyId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "asset-family" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "renderPartId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "render-part" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "characterProfileId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "character-profile" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "animationSetId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "animation-set" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "animationClipId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "animation-clip" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "connectivityFamilyId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "connectivity-family" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "connectivityVariantId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "connectivity-variant" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "commandId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "command" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "resultId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "result" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "eventId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "event" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "intentId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "intent" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "actionId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "action" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "queueTicketId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "queue-ticket" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "reservationId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "reservation" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "snapshotId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "snapshot" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "traceId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "trace" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "externalInputId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "external-input" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "worldRevisionId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "world-revision" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "tickId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "tick" },
        "value": { "$ref": "#/$defs/nonNegativeSafeInteger" }
      }
    },
    "typedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "$ref": "#/$defs/identityKind" },
        "value": { "$ref": "#/$defs/slug" }
      }
    },
    "buildingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/buildingId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "floorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/floorId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "roomReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/roomId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "entityDefinitionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/entityDefinitionId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "entityInstanceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/entityInstanceId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "facilityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/facilityId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "socketReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/socketId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "geometryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/geometryId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "definitionBundleReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/definitionBundleId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "useSlotReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/useSlotId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "interactionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/interactionId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "assetFamilyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/assetFamilyId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "renderPartReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/renderPartId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "characterProfileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/characterProfileId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "animationSetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/animationSetId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "animationClipReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/animationClipId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "connectivityFamilyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/connectivityFamilyId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "connectivityVariantReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/connectivityVariantId" },
        "version": { "$ref": "#/$defs/positiveVersion" }
      }
    },
    "worldFacing": {
      "enum": ["north", "east", "south", "west"]
    },
    "screenFacing": {
      "enum": ["north-east", "south-east", "south-west", "north-west"]
    },
    "cellPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "x", "y", "elevation"],
      "properties": {
        "space": { "const": "cell" },
        "x": { "$ref": "#/$defs/safeInteger" },
        "y": { "$ref": "#/$defs/safeInteger" },
        "elevation": { "$ref": "#/$defs/nonNegativeSafeInteger" }
      }
    },
    "subCellPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "x", "y", "elevation"],
      "properties": {
        "space": { "const": "sub-cell" },
        "x": { "$ref": "#/$defs/safeInteger" },
        "y": { "$ref": "#/$defs/safeInteger" },
        "elevation": { "$ref": "#/$defs/nonNegativeSafeInteger" }
      }
    },
    "floorLocalCellPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "floor", "coordinate"],
      "properties": {
        "space": { "const": "floor-local-cell" },
        "floor": { "$ref": "#/$defs/floorReference" },
        "coordinate": { "$ref": "#/$defs/cellPosition" }
      }
    },
    "floorLocalSubCellPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "floor", "coordinate"],
      "properties": {
        "space": { "const": "floor-local-sub-cell" },
        "floor": { "$ref": "#/$defs/floorReference" },
        "coordinate": { "$ref": "#/$defs/subCellPosition" }
      }
    },
    "definitionLocalGeometryPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "x", "y", "elevation"],
      "properties": {
        "space": { "const": "definition-local-geometry" },
        "x": { "$ref": "#/$defs/safeInteger" },
        "y": { "$ref": "#/$defs/safeInteger" },
        "elevation": { "$ref": "#/$defs/nonNegativeSafeInteger" }
      }
    },
    "definitionLocalCellOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "x", "y", "elevation"],
      "properties": {
        "space": { "const": "definition-local-cell" },
        "x": { "$ref": "#/$defs/safeInteger" },
        "y": { "$ref": "#/$defs/safeInteger" },
        "elevation": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "definitionLocalSubCellOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "x", "y", "elevation"],
      "properties": {
        "space": { "const": "definition-local-sub-cell" },
        "x": { "$ref": "#/$defs/safeInteger" },
        "y": { "$ref": "#/$defs/safeInteger" },
        "elevation": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "orientationTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "quarterTurnsClockwise"],
      "properties": {
        "orientation": { "$ref": "#/$defs/worldFacing" },
        "quarterTurnsClockwise": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "definitionLocalPixelPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "xPx", "yPx"],
      "properties": {
        "space": { "const": "definition-local-pixel" },
        "xPx": { "$ref": "#/$defs/safeInteger" },
        "yPx": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "spritePixelPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "xPx", "yPx"],
      "properties": {
        "space": { "const": "sprite-pixel" },
        "xPx": { "$ref": "#/$defs/safeInteger" },
        "yPx": { "$ref": "#/$defs/safeInteger" }
      }
    },
    "screenPixelPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "xPx", "yPx"],
      "properties": {
        "space": { "const": "screen-pixel" },
        "xPx": { "$ref": "#/$defs/finiteNumber" },
        "yPx": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "coordinate": {
      "oneOf": [
        { "$ref": "#/$defs/cellPosition" },
        { "$ref": "#/$defs/subCellPosition" },
        { "$ref": "#/$defs/floorLocalCellPosition" },
        { "$ref": "#/$defs/floorLocalSubCellPosition" },
        { "$ref": "#/$defs/definitionLocalGeometryPosition" },
        { "$ref": "#/$defs/definitionLocalCellOffset" },
        { "$ref": "#/$defs/definitionLocalSubCellOffset" },
        { "$ref": "#/$defs/definitionLocalPixelPosition" },
        { "$ref": "#/$defs/spritePixelPosition" },
        { "$ref": "#/$defs/screenPixelPosition" }
      ]
    },
    "coordinateSemanticsVersion": {
      "const": "office-coordinate-semantics-v1"
    },
    "projectionId": {
      "const": "office-projection-v1"
    }
  }
}
