{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/activity-intent.schema.json",
  "title": "Office V2 Activity Intent",
  "$defs": {
    "intentDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "intentId",
        "intentVersion",
        "sourceKind",
        "workflowRunId",
        "taskId",
        "capability",
        "priorityClass",
        "issueTick",
        "notBeforeTick",
        "cancellationPolicy",
        "preemptionPolicy",
        "coalesceKey",
        "targetSelectorVersion",
        "presentationOnly"
      ],
      "properties": {
        "schemaVersion": { "const": "office-activity-intent-v1" },
        "intentId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/intentId" },
        "intentVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "sourceKind": { "enum": ["durable-operational", "decorative"] },
        "workflowRunId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/workflowRunId" },
        "taskId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/taskId" },
        "sourceEventId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/eventId" },
        "capability": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "priorityClass": { "enum": ["durable", "decorative"] },
        "issueTick": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "notBeforeTick": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "expiresTick": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "cancellationPolicy": { "enum": ["cancelable", "non-cancelable"] },
        "preemptionPolicy": { "enum": ["never", "decorative-only", "resume-after-yield"] },
        "coalesceKey": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "targetSelectorVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "presentationOnly": { "const": true }
      }
    }
  },
  "$ref": "#/$defs/intentDocument"
}
