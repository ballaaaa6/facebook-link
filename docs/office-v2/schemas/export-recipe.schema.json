{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/export-recipe.schema.json",
  "title": "Office V2 Deterministic Export Recipe",
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "integrity", "licenseStatus"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "integrity": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "licenseStatus": { "enum": ["project-owned", "licensed"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^office-v2/(runtime|metadata|reviews)/[a-z0-9/_-]+\\.(png|json|md)$" },
        "kind": { "enum": ["png", "metadata", "review-board"] },
        "sha256": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" }
      }
    },
    "exportRecipeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "recipeId", "recipeVersion", "sourceSetRef", "authoringProfile",
        "tool", "arguments", "dependencies", "locale", "colorProfile", "cleanOutputDirectory",
        "outputs", "overwritePolicy", "determinism"
      ],
      "properties": {
        "schemaVersion": { "const": "office-export-recipe-v1" },
        "recipeId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "recipeVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "sourceSetRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
            "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" }
          }
        },
        "authoringProfile": { "enum": ["native-2d", "fixed-camera-3d", "hybrid"] },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "executableSha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "executableSha256": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" }
          }
        },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
        "colorProfile": { "enum": ["srgb", "linear-srgb"] },
        "cleanOutputDirectory": { "type": "string", "pattern": "^office-v2/(runtime|metadata|reviews)/[a-z0-9/_-]+$" },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } },
        "overwritePolicy": { "const": "fail" },
        "determinism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["twoCleanBuilds", "byteEquality", "stableInputOrder"],
          "properties": {
            "twoCleanBuilds": { "const": "required" },
            "byteEquality": { "const": "required" },
            "stableInputOrder": { "const": "declared" }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/exportRecipeDocument"
}
