{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/operations-snapshot-v2.schema.json",
  "title": "Office V2 Operations Snapshot V2",
  "$defs": {
    "workIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflowRunId", "taskId", "jobId", "stage"],
      "properties": {
        "workflowRunId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/workflowRunId" },
        "taskId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/taskId" },
        "jobId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "stage": { "$ref": "#/$defs/workflowStage" }
      }
    },
    "workflowStage": {
      "enum": [
        "discovered",
        "scored",
        "selected",
        "link_ready",
        "content_queued",
        "content_ready",
        "qa_approved",
        "scheduled",
        "published",
        "measured",
        "failed"
      ]
    },
    "structuredReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "owner", "recoverability", "message"],
      "properties": {
        "kind": { "enum": ["waiting", "review", "blocked", "failure"] },
        "code": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "owner": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "recoverability": { "$ref": "#/$defs/recoverability" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "recoverability": {
      "enum": ["not-required", "retry", "reconnect", "resync", "human-review", "permanent"]
    },
    "sessionHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedAt"],
      "properties": {
        "status": { "enum": ["available", "degraded", "reconnecting", "unavailable"] },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "durableTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durableEventId", "sequence", "payloadDigest", "occurredAt", "sourceRevision"],
      "properties": {
        "durableEventId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/eventId" },
        "sequence": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "payloadDigest": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "sourceRevision": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" }
      }
    },
    "eventRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durableEventId", "sequence", "payloadDigest", "occurredAt", "workflowRunId", "taskId", "jobId", "stage", "eventType"],
      "properties": {
        "durableEventId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/eventId" },
        "sequence": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "payloadDigest": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "workflowRunId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/workflowRunId" },
        "taskId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/taskId" },
        "jobId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "stage": { "$ref": "#/$defs/workflowStage" },
        "eventType": { "enum": ["stage-transition", "task-update", "job-completed", "branch-completed", "join-emitted", "session-updated"] }
      }
    },
    "featureAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "roleEnabled", "connectorEnabled", "sessionAvailable", "available", "diagnosticOwner", "recoverability"],
      "properties": {
        "featureId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "roleEnabled": { "type": "boolean" },
        "connectorEnabled": { "type": "boolean" },
        "sessionAvailable": { "type": "boolean" },
        "available": { "type": "boolean" },
        "diagnosticOwner": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "recoverability": { "$ref": "#/$defs/recoverability" }
      }
    },
    "agentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentInstanceId", "roleId", "displayName", "status", "freshness", "work", "reason", "sessionHealth", "featureIds", "lastTransition", "diagnosticOwner", "recoverability"],
      "properties": {
        "agentInstanceId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/actorId" },
        "roleId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "displayName": { "type": "string", "minLength": 1 },
        "status": { "enum": ["working", "waiting", "review", "blocked", "failed", "unavailable", "idle"] },
        "freshness": { "enum": ["live", "stale", "reconnecting", "unavailable"] },
        "work": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/workIdentity" }
          ]
        },
        "reason": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/structuredReason" }
          ]
        },
        "sessionHealth": { "$ref": "#/$defs/sessionHealth" },
        "featureIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" }
        },
        "lastTransition": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/durableTransition" }
          ]
        },
        "diagnosticOwner": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "recoverability": { "$ref": "#/$defs/recoverability" }
      }
    },
    "diagnosticContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subjectId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "pointer": { "type": "string", "pattern": "^/" },
        "expected": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "actual": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" }
      }
    },
    "adapterDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "owner", "version", "message", "context"],
      "properties": {
        "code": { "type": "string", "pattern": "^adapter\\.[a-z][a-z0-9.-]*$" },
        "owner": { "const": "adapter" },
        "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "message": { "type": "string", "minLength": 1 },
        "context": { "$ref": "#/$defs/diagnosticContext" }
      }
    },
    "snapshotDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "snapshotId", "observedAt", "sourceRevision", "streamId", "streamEpoch", "windowStartSequence", "throughSequence", "eventDigest", "freshness", "events", "agents", "features", "diagnostics"],
      "properties": {
        "schemaVersion": { "const": "office-operations-v2" },
        "snapshotId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/snapshotId" },
        "observedAt": { "type": "string", "format": "date-time" },
        "sourceRevision": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "streamId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "streamEpoch": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "windowStartSequence": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "throughSequence": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "eventDigest": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "freshness": { "enum": ["live", "stale", "reconnecting", "unavailable"] },
        "events": { "type": "array", "items": { "$ref": "#/$defs/eventRecord" } },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/agentRecord" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/featureAvailability" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/adapterDiagnostic" } }
      }
    }
  },
  "$ref": "#/$defs/snapshotDocument"
}
