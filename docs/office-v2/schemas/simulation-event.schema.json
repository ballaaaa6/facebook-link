{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/simulation-event.schema.json",
  "title": "Office V2 Simulation Event",
  "$defs": {
    "eventPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actorId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/actorId" },
        "intentId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/intentId" },
        "reservationId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/reservationId" },
        "state": { "enum": ["idle", "planning", "moving", "interacting", "blocked"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "eventDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "eventId", "eventVersion", "emittedTick", "sequence", "kind", "payload"],
      "properties": {
        "schemaVersion": { "const": "office-simulation-event-v2" },
        "eventId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/eventId" },
        "eventVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "emittedTick": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "sequence": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "sourceCommandId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/commandId" },
        "kind": { "enum": ["command-accepted", "command-rejected", "actor-state-changed", "reservation-released", "interaction-completed"] },
        "payload": { "$ref": "#/$defs/eventPayload" }
      }
    }
  },
  "$ref": "#/$defs/eventDocument"
}
