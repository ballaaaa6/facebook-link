{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/atlas.schema.json",
  "title": "Office V2 Deterministic Atlas",
  "$defs": {
    "versionedSlugReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "version": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xPx", "yPx", "widthPx", "heightPx"],
      "properties": {
        "xPx": { "type": "integer", "minimum": 0 },
        "yPx": { "type": "integer", "minimum": 0 },
        "widthPx": { "type": "integer", "minimum": 1 },
        "heightPx": { "type": "integer", "minimum": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryId", "familyRef", "variantId", "frameRef", "geometryRef", "orientation", "rect", "order"],
      "properties": {
        "entryId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "familyRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/assetFamilyReference" },
        "variantId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "frameRef": { "$ref": "#/$defs/versionedSlugReference" },
        "geometryRef": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/geometryReference" },
        "orientation": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/worldFacing" },
        "rect": { "$ref": "#/$defs/rect" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "atlasDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "atlasId", "atlasVersion", "path", "sha256", "paddingPx", "extrusionPx", "rotation", "trimming", "entries"],
      "properties": {
        "schemaVersion": { "const": "office-atlas-v1" },
        "atlasId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/slug" },
        "atlasVersion": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "path": { "type": "string", "pattern": "^office-v2/atlases/[a-z0-9/_-]+\\.png$" },
        "sha256": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/sha256" },
        "paddingPx": { "type": "integer", "minimum": 0, "maximum": 16 },
        "extrusionPx": { "type": "integer", "minimum": 0, "maximum": 16 },
        "rotation": { "const": "forbidden-v1" },
        "trimming": { "const": "forbidden-v1" },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
      }
    }
  },
  "$ref": "#/$defs/atlasDocument"
}
