{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affiliate-operations.example/schemas/office-v2/action-queue.schema.json",
  "title": "Office V2 Actor Action Queue",
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "intentId", "phase", "progressTicks", "resourceKeys"],
      "properties": {
        "actionId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/actionId" },
        "intentId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/intentId" },
        "phase": { "enum": ["requested", "en-route", "waiting", "acquired", "using", "released", "canceled", "failed"] },
        "progressTicks": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/nonNegativeSafeInteger" },
        "resourceKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z][a-z0-9-]{1,63}$" }
        },
        "targetEntityId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/entityInstanceId" },
        "failureReason": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" }
      }
    },
    "actionQueueDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "queueId", "actorId", "revision", "actions"],
      "properties": {
        "schemaVersion": { "const": "office-action-queue-v1" },
        "queueId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/actionId" },
        "actorId": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/actorId" },
        "revision": { "$ref": "https://affiliate-operations.example/schemas/office-v2/common-v2.schema.json#/$defs/positiveVersion" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    }
  },
  "$ref": "#/$defs/actionQueueDocument"
}
