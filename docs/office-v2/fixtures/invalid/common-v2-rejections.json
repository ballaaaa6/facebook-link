{
  "schemaVersion": "office-common-v2-rejections-v1",
  "cases": [
    {
      "name": "cell-supplied-to-sub-cell",
      "definition": "subCellPosition",
      "value": { "space": "cell", "x": 0, "y": 0, "elevation": 0 },
      "expectedFailure": "contract.coordinate-space-mismatch"
    },
    {
      "name": "duplicate-building-id",
      "semantic": "duplicate-identity",
      "definition": "buildingId",
      "values": [
        { "kind": "building", "value": "hq" },
        { "kind": "building", "value": "hq" }
      ],
      "expectedFailure": "contract.identifier-duplicate"
    },
    {
      "name": "floor-reference-uses-building-id",
      "definition": "floorReference",
      "value": { "id": { "kind": "building", "value": "hq" }, "version": 1 },
      "expectedFailure": "contract.identifier-namespace-mismatch"
    },
    {
      "name": "reference-version-missing",
      "definition": "floorReference",
      "value": { "id": { "kind": "floor", "value": "ground-floor" } },
      "expectedFailure": "contract.reference-version-missing"
    },
    {
      "name": "reference-latest-forbidden",
      "definition": "floorReference",
      "value": { "id": { "kind": "floor", "value": "ground-floor" }, "version": "latest" },
      "expectedFailure": "contract.reference-latest-forbidden"
    },
    {
      "name": "fractional-cell",
      "definition": "cellPosition",
      "value": { "space": "cell", "x": 0.5, "y": 0, "elevation": 0 },
      "expectedFailure": "contract.coordinate-integrality"
    },
    {
      "name": "unsafe-cell",
      "definition": "cellPosition",
      "value": { "space": "cell", "x": 9007199254740992, "y": 0, "elevation": 0 },
      "expectedFailure": "contract.coordinate-range"
    },
    {
      "name": "negative-elevation",
      "definition": "cellPosition",
      "value": { "space": "cell", "x": 0, "y": 0, "elevation": -1 },
      "expectedFailure": "contract.coordinate-range"
    },
    {
      "name": "generic-position",
      "semantic": "generic-position",
      "value": { "position": { "x": 0, "y": 0 } },
      "expectedFailure": "contract.generic-position-forbidden"
    },
    {
      "name": "unknown-world-facing",
      "definition": "worldFacing",
      "value": "north-west",
      "expectedFailure": "contract.facing-invalid"
    }
  ]
}
