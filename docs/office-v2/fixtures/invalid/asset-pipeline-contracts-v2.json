{
  "schemaVersion": "office-asset-pipeline-rejections-v1",
  "cases": [
    { "name": "invalid-scale", "kind": "schema", "schema": "style-profile.schema.json", "document": { "schemaVersion": "office-style-profile-v1", "nativePixelDensity": 0 }, "expectedValid": false, "expectedFailure": "asset.style-scale-invalid" },
    { "name": "invalid-palette", "kind": "schema", "schema": "style-profile.schema.json", "document": { "schemaVersion": "office-style-profile-v1", "palette": { "roles": [{ "role": "outline", "colors": ["white"], "maximumVarianceSteps": 0 }] } }, "expectedValid": false, "expectedFailure": "asset.style-palette-invalid" },
    { "name": "invalid-padding", "kind": "schema", "schema": "style-profile.schema.json", "document": { "schemaVersion": "office-style-profile-v1", "canvasClasses": [{ "id": "character-canvas", "padding": { "leftPx": -1, "rightPx": 0, "topPx": 0, "bottomPx": 0 } }] }, "expectedValid": false, "expectedFailure": "asset.style-padding-invalid" },
    { "name": "missing-provenance", "kind": "schema", "schema": "source-set.schema.json", "document": { "schemaVersion": "office-source-set-v1", "sourceSetId": "orphan-sources" }, "expectedValid": false, "expectedFailure": "asset.provenance-missing" },
    { "name": "missing-recipe", "kind": "schema", "schema": "asset-family-v2.schema.json", "document": { "schemaVersion": "office-asset-family-v2", "familyId": "missing-recipe", "familyVersion": 1 }, "expectedValid": false, "expectedFailure": "asset.export-recipe-missing" },
    { "name": "invalid-light-vector", "kind": "semantic", "check": "style-light", "data": { "vectorX": 0, "vectorY": 0, "vectorZ": 0 }, "expectedValid": false, "expectedFailure": "asset.style-light-invalid" },
    { "name": "invalid-shadow-policy", "kind": "semantic", "check": "style-shadow", "data": { "vectorX": 0, "vectorY": 0, "opacitySteps": 99 }, "expectedValid": false, "expectedFailure": "asset.style-shadow-invalid" },
    { "name": "invalid-zoom-order", "kind": "semantic", "check": "style-zoom", "data": { "zoomStops": [{ "id": "native", "scale": 1 }, { "id": "duplicate", "scale": 1 }] }, "expectedValid": false, "expectedFailure": "asset.style-zoom-invalid" },
    { "name": "wrong-source-hash", "kind": "semantic", "check": "source-hash", "data": { "declared": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "actual": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }, "expectedValid": false, "expectedFailure": "asset.source-hash-mismatch" },
    { "name": "unapproved-commercial-status", "kind": "semantic", "check": "commercial-review", "data": { "commercialStatus": "pending-review", "admission": "runtime-approved" }, "expectedValid": false, "expectedFailure": "asset.commercial-review" },
    { "name": "orphan-source", "kind": "semantic", "check": "orphan", "data": { "orphanKind": "source" }, "expectedValid": false, "expectedFailure": "asset.orphan-reference" },
    { "name": "orphan-recipe", "kind": "semantic", "check": "orphan", "data": { "orphanKind": "recipe" }, "expectedValid": false, "expectedFailure": "asset.orphan-reference" },
    { "name": "orphan-runtime", "kind": "semantic", "check": "orphan", "data": { "orphanKind": "runtime" }, "expectedValid": false, "expectedFailure": "asset.orphan-reference" },
    { "name": "orphan-atlas", "kind": "semantic", "check": "orphan", "data": { "orphanKind": "atlas" }, "expectedValid": false, "expectedFailure": "asset.orphan-reference" },
    { "name": "orphan-catalog", "kind": "semantic", "check": "orphan", "data": { "orphanKind": "catalog" }, "expectedValid": false, "expectedFailure": "asset.orphan-reference" },
    { "name": "orphan-review", "kind": "semantic", "check": "orphan", "data": { "orphanKind": "review" }, "expectedValid": false, "expectedFailure": "asset.orphan-reference" },
    { "name": "render-part-cycle", "kind": "semantic", "check": "render-part-graph", "data": { "parts": [{ "id": "part-a", "parent": "part-b" }, { "id": "part-b", "parent": "part-a" }] }, "expectedValid": false, "expectedFailure": "world.render-attachment-cycle" },
    { "name": "wrong-geometry-version", "kind": "semantic", "check": "geometry-reference", "data": { "declared": { "id": "proof-workstation-geometry", "version": 2 }, "authoritative": { "id": "proof-workstation-geometry", "version": 1 } }, "expectedValid": false, "expectedFailure": "world.reference-version-mismatch" },
    { "name": "asset-occupancy-field", "kind": "schema", "schema": "asset-family-v2.schema.json", "document": { "schemaVersion": "office-asset-family-v2", "familyId": "occupancy-leak", "familyVersion": 1, "footprint": [{ "x": 0, "y": 0 }] }, "expectedValid": false, "expectedFailure": "world.asset-occupancy-forbidden" },
    { "name": "missing-connectivity-variant", "kind": "semantic", "check": "connectivity-table", "data": { "supportedMasks": [0, 2, 8, 10], "variants": [0, 2, 8] }, "expectedValid": false, "expectedFailure": "connectivity.missing-variant" },
    { "name": "unsupported-connectivity-mask", "kind": "semantic", "check": "connectivity-mask", "data": { "requestedMask": 1, "supportedMasks": [0, 2, 8, 10] }, "expectedValid": false, "expectedFailure": "connectivity.unsupported-mask" },
    { "name": "missing-bundle-reference", "kind": "semantic", "check": "bundle-reference", "data": { "catalogEntryId": "missing-entry", "catalogEntries": ["proof-workstation-isolated"] }, "expectedValid": false, "expectedFailure": "asset.bundle-reference-missing" },
    { "name": "unsupported-semantic-variant", "kind": "semantic", "check": "semantic-variant", "data": { "operationalState": "working", "semanticAnimationState": "drinking", "facilityState": "occupied", "connectivityMask": 0, "fallback": "none", "supported": ["working:typing:occupied:0"] }, "expectedValid": false, "expectedFailure": "asset.semantic-variant-unsupported" },
    { "name": "failed-migration", "kind": "semantic", "check": "migration", "data": { "requiredContext": ["geometry", "review"], "suppliedContext": ["review"], "mapping": [] }, "expectedValid": false, "expectedFailure": "asset.migration-failed" }
  ]
}
